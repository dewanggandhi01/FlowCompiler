# ===================================================
# FlowCompiler Environment Configuration
# ===================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===================================================

# ── LLM Provider (choose ONE option below) ──────

# OPTION A: Direct OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=
# (leave OPENAI_BASE_URL empty to use default OpenAI endpoint)

# OPTION B: AI Pipe (IIT Madras proxy — free $1 credit)
# OPENAI_API_KEY=eyJhbGciOiJIUzI1NiJ9.your-aipipe-token-here
# OPENAI_BASE_URL=https://aipipe.org/openai/v1

# ── Active Config (uncomment ONE option above and fill here) ──
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0

# ── PostgreSQL ───────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowcompiler

# ── Supabase (optional) ─────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── App ──────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Pipeline ────────────────────────────────────
MAX_REPAIR_ITERATIONS=3
MAX_RETRIES=3

# ── Evaluation ──────────────────────────────────
MAX_CONCURRENT_EVALUATIONS=5
